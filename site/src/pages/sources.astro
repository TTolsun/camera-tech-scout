---
import Base from '../layouts/Base.astro';
import { sources, formatDateTime } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const statusLabel: Record<string, string> = {
  ok: '정상 완료',
  partial: '부분 완료',
  error: '실패',
  pending: '미분석',
};
const statusClass: Record<string, string> = {
  ok: 'badge badge--outline',
  partial: 'badge badge--warn',
  error: 'badge badge--reject',
  pending: 'badge badge--quiet',
};
---

<Base
  title="Sources"
  active="sources"
  description="현재 분석 대상인 Organization과 Repository입니다."
>
  <section class="band band--tight">
    <div class="container">
      <p class="eyebrow">Sources</p>
      <h1>분석 대상</h1>
      <p class="lead">
        분석 대상은 설정 파일 <span class="mono">config/sources.yaml</span> 하나로 관리됩니다.
        Organization 단위 탐색과 Repository 직접 지정을 함께 쓸 수 있으며, 두 경로로 중복 발견된
        Repository는 한 번만 분석하고 어떤 경로로 편입되었는지 함께 기록합니다.
      </p>
    </div>
  </section>

  <section class="band band--cloud">
    <div class="container stack-lg">
      <div>
        <div class="section-head">
          <div>
            <p class="eyebrow">Organization 단위</p>
            <h2>Organizations</h2>
          </div>
        </div>

        {sources.organizations.length === 0 && <p class="muted">설정된 Organization이 없습니다.</p>}

        <div class="grid grid--2">
          {
            sources.organizations.map((org: any) => (
              <article class="card">
                <h3 class="card-title">
                  <a href={org.url} target="_blank" rel="noopener noreferrer">{org.org}</a>
                </h3>
                {org.notes && <p class="caption">{org.notes}</p>}

                <dl class="kv">
                  <dt>탐색된 Repository</dt>
                  <dd>{org.repositoriesListed}개</dd>
                  <dt>선택된 Repository</dt>
                  <dd>{org.repositoriesSelected?.length ?? 0}개</dd>
                  <dt>이름 필터</dt>
                  <dd class="mono">
                    {(org.matchPatterns ?? []).join(', ') || '없음 (전체 대상)'}
                  </dd>
                  <dt>최대 개수</dt>
                  <dd>{org.maxRepositories}</dd>
                </dl>

                {!org.listingAvailable && (
                  <p class="fine">
                    <span class="marker">NEEDS_VERIFICATION</span>
                    GitHub API가 이 Organization의 Repository 목록을 반환하지 않았습니다.
                  </p>
                )}

                {(org.selectedDetails ?? []).length > 0 && (
                  <div class="table-wrap org-table">
                    <table>
                      <thead>
                        <tr>
                          <th>Repository</th>
                          <th>상태</th>
                          <th class="num">Evidence</th>
                          <th class="num">후보</th>
                        </tr>
                      </thead>
                      <tbody>
                        {org.selectedDetails.map((row: any) => (
                          <tr>
                            <td class="mono">{row.fullName}</td>
                            <td>
                              <span class={statusClass[row.status] ?? 'badge badge--quiet'}>
                                {statusLabel[row.status] ?? row.status}
                              </span>
                            </td>
                            <td class="num">{row.evidenceCount}</td>
                            <td class="num">{row.candidateCount}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <div class="section-head">
          <div>
            <p class="eyebrow">분석 대상 전체</p>
            <h2>Repositories</h2>
          </div>
          <a href={`${base}/repositories/`}>Repository 상세 &rarr;</a>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Repository</th>
                <th>편입 경로</th>
                <th>상태</th>
                <th>스캔 방식</th>
                <th>마지막 분석 Commit</th>
                <th>Last Scan</th>
                <th class="num">파일</th>
                <th class="num">Evidence</th>
                <th class="num">후보</th>
                <th>주요 기술 영역</th>
              </tr>
            </thead>
            <tbody>
              {
                sources.repositories.map((repo: any) => (
                  <tr>
                    <td>
                      <a class="mono" href={repo.url} target="_blank" rel="noopener noreferrer">
                        {repo.fullName}
                      </a>
                      {repo.notes && <p class="fine">{repo.notes}</p>}
                    </td>
                    <td class="fine mono">{(repo.origins ?? []).join(', ')}</td>
                    <td>
                      <span class={statusClass[repo.status] ?? 'badge badge--quiet'}>
                        {statusLabel[repo.status] ?? repo.status}
                      </span>
                      {repo.statusDetail && <p class="fine">{repo.statusDetail}</p>}
                    </td>
                    <td class="fine">{repo.scanMode === 'incremental' ? '증분' : '전체'}</td>
                    <td class="mono fine">{(repo.lastScannedSha ?? '기록 없음').slice(0, 12)}</td>
                    <td class="fine">{formatDateTime(repo.lastScanTime)}</td>
                    <td class="num">{repo.filesScanned ?? 0}</td>
                    <td class="num">{repo.evidenceCount ?? 0}</td>
                    <td class="num">{repo.candidateCount ?? 0}</td>
                    <td class="fine">{(repo.topicLabels ?? []).join(', ') || '식별되지 않음'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      {
        sources.skipped.length > 0 && (
          <div>
            <div class="section-head">
              <div>
                <p class="eyebrow">제외</p>
                <h2>분석하지 않은 대상</h2>
              </div>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>대상</th>
                    <th>사유</th>
                  </tr>
                </thead>
                <tbody>
                  {sources.skipped.map((row: any) => (
                    <tr>
                      <td class="mono">{row.target}</td>
                      <td>{row.reason}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )
      }

      {
        sources.apiProblems.length > 0 && (
          <div>
            <div class="section-head">
              <div>
                <p class="eyebrow">수집 실패</p>
                <h2>GitHub API 문제</h2>
              </div>
            </div>
            <p class="lead">
              아래 요청이 응답하지 않았습니다. 해당 Repository의 분석 결과는 부분적일 수 있습니다.
            </p>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Endpoint</th>
                    <th class="num">상태</th>
                    <th>내용</th>
                  </tr>
                </thead>
                <tbody>
                  {sources.apiProblems.map((row: any) => (
                    <tr>
                      <td class="mono fine">{row.endpoint}</td>
                      <td class="num">{row.status}</td>
                      <td class="fine">{row.detail}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <style>
    .org-table {
      margin-top: var(--sp-md);
    }
  </style>
</Base>
